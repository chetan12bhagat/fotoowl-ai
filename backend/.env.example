# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Database Configuration (defaults to local SQLite if not PostgreSQL)
DATABASE_URL=sqlite:///./fotoowl.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/fotoowl

# Security & JWT Configuration
JWT_SECRET_KEY=fotoowl_super_secret_jwt_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OTP Settings
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
MAX_OTP_ATTEMPTS=5

# SMTP Email Configuration (Gmail, SendGrid, Mailgun, AWS SES, etc.)
# For Gmail: Use a Google App Password (16 characters), not your personal Gmail login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=FotoOwl AI <your-email@gmail.com>
SMTP_TLS=True
